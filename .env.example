# Public Supabase values. Safe to expose. Row Level Security decides who can write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Web3Forms access key. It is meant to be visible in the browser.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Server-only. Used by /api/github-stats. Never put a GitHub token here.
GITHUB_USERNAME=
